{
  "functions": {
    "config/wsgi.py": {
      "includeFiles": "frontend_dist/**",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/config/wsgi.py"
    },
    {
      "source": "/:match*",
      "destination": "/config/wsgi.py"
    }
  ]
}
