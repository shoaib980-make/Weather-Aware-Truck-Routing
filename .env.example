# ==============================================================================
# SafeHaul RouteIQ - Environment Configuration Template
# Copy this file to .env and customize for your environment.
# ==============================================================================

# --- Django Core Settings ---
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.fly.dev,*.onrender.com

# --- Port & Server ---
PORT=8000

# --- External Logistics & Weather Services (Default: Free Public APIs) ---
# Identification header required by OpenStreetMap / Nominatim Acceptable Use Policy
HTTP_USER_AGENT=WeatherAwareTruckRouting/1.0 (logistics-dispatch@example.com)

# OSRM Routing Service (can be overridden with self-hosted instance)
OSRM_URL=https://router.project-osrm.org

# Open-Meteo Weather Forecast API
WEATHER_URL=https://api.open-meteo.com/v1/forecast

# Nominatim Geocoding API
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Commercial Truck Driving Duration Adjustment Factor
# OSRM routes are timed for passenger cars; 1.15 accounts for 55-65 mph truck speed limits
TRUCK_TIME_FACTOR=1.15

# --- Frontend Build Options (Optional) ---
# If hosting the frontend on a different domain or CDN than Django, set this to Django's base URL:
# VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=
